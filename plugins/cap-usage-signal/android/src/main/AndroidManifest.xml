<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 使用情况访问（特殊权限，非运行时弹窗）：用户须在
         设置 → 应用 → 特殊应用权限 → 使用情况访问 中手动开启。
         插件只回传聚合结果，原始事件流不出原生层。 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ 包可见性：没有它，PackageManager 对第三方包（微信/
         王者等）一律 NameNotFoundException，"数字健康台"只能显示包名尾段
         （mm/sgame，第 81 轮真机实测）。装包即授予、无运行时弹窗；
         本应用仅 GitHub 分发，不涉 Play 商店对该权限的政策限制；
         读取范围严格小于已授权的使用情况统计——只取显示名，不出原生层。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
</manifest>
